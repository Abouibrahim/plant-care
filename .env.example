# Copy to .env.local for local development and set the same names in the Vercel dashboard.
# Never commit .env.local. Values are added by Mohamed only.

# Claude API (server only)
ANTHROPIC_API_KEY=

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The one account the /api routes accept: the UUID of your user under Authentication -> Users.
# Not a secret, but required; without it every route answers 500.
OWNER_USER_ID=

# Supabase (browser; the VITE_ prefix exposes them to the client, which is intended for these two)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=

# Cron protection (Vercel sends this header on cron calls; set any long random string)
CRON_SECRET=

# Satellite map (optional, Phase 9): an ArcGIS Location Platform API key with the Basemaps privilege.
# It is built into the app's code, as map tile keys are; lock it to the app's address (referrers) in
# the ArcGIS portal. Without it the map shows the OpenStreetMap street map.
VITE_ARCGIS_API_KEY=
