{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/daily", "schedule": "0 5 * * *" }],
  "functions": {
    "api/*.ts": {
      "includeFiles": "prompts/**",
      "maxDuration": 300
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
